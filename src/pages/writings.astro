---
import Base from '../layouts/Base.astro';
---
<Base title="Writings | aksyuma">
	<section class="max-w-2xl">
		<h1 class="text-4xl font-extrabold tracking-tight mb-4 font-mono">
			Writings
		</h1>
		<p class="text-zinc-400 text-base leading-relaxed mb-12">
			Technical writing on distributed systems, platform engineering, and operational decisions.
		</p>

		<div class="space-y-12">
			<div>
				<h2 class="text-sm font-mono tracking-widest text-zinc-500 uppercase mb-4">// 2026</h2>
				<div class="space-y-4">
					<div class="flex items-start gap-3 text-zinc-500">
						<span class="text-emerald-500/50 mt-0.5 shrink-0">→</span>
						<div>
							<span class="text-zinc-400">Backpressure at the Write Boundary</span>
							<span class="ml-2 text-xs border border-zinc-700 px-1.5 py-0.5 rounded text-zinc-600">coming</span>
						</div>
					</div>
					<div class="flex items-start gap-3 text-zinc-500">
						<span class="text-emerald-500/50 mt-0.5 shrink-0">→</span>
						<div>
							<span class="text-zinc-400">Event Contracts Before Brokers</span>
							<span class="ml-2 text-xs border border-zinc-700 px-1.5 py-0.5 rounded text-zinc-600">coming</span>
						</div>
					</div>
					<div class="flex items-start gap-3 text-zinc-500">
						<span class="text-emerald-500/50 mt-0.5 shrink-0">→</span>
						<div>
							<span class="text-zinc-400">Platform Migration: GitHub → Forgejo</span>
							<span class="ml-2 text-xs border border-zinc-700 px-1.5 py-0.5 rounded text-zinc-600">coming</span>
						</div>
					</div>
				</div>
			</div>

			<div>
				<h2 class="text-sm font-mono tracking-widest text-zinc-500 uppercase mb-4">// 2020 · Medium</h2>
				<div class="space-y-4">
					<a href="https://medium.com/@syumak/how-to-send-push-notifications-to-ios-devices-via-p8-key-using-amazon-pinpoint-f08efb2a6b7" target="_blank" rel="noopener" class="group flex items-start gap-3">
						<span class="text-emerald-400 mt-0.5 shrink-0">→</span>
						<div>
							<span class="text-zinc-200 group-hover:text-emerald-400 transition-colors">Push Notifications to iOS via .p8 Key with Amazon Pinpoint</span>
							<p class="text-zinc-500 text-sm mt-1">Step-by-step APNs token auth integration with AWS Pinpoint SDK</p>
							<div class="flex gap-2 mt-2">
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">AWS</span>
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">Pinpoint</span>
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">iOS</span>
							</div>
						</div>
					</a>
					<a href="https://medium.com/@syumak/how-to-change-your-email-identity-from-address-to-use-a-friendly-sender-name-using-amazon-938c8d1dcb0" target="_blank" rel="noopener" class="group flex items-start gap-3">
						<span class="text-emerald-400 mt-0.5 shrink-0">→</span>
						<div>
							<span class="text-zinc-200 group-hover:text-emerald-400 transition-colors">Friendly Sender Names with Amazon Pinpoint Email Channel</span>
							<p class="text-zinc-500 text-sm mt-1">Configuring email identity "From" address via AWS CLI</p>
							<div class="flex gap-2 mt-2">
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">AWS</span>
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">Pinpoint</span>
								<span class="font-mono text-xs text-zinc-600 bg-zinc-900 px-2 py-0.5 border border-zinc-800 rounded">CLI</span>
							</div>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
